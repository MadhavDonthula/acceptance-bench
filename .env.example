# Copy to .env and fill in. .env is gitignored and must never be committed or printed.

# CoralBricks (OpenAI Chat Completions compatible)
CORALBRICKS_API_KEY=cb_your_key_here

# Baseten (OpenAI Chat Completions compatible)
BASETEN_API_KEY=your_baseten_key_here

# Which Baseten slug to use. MUST match the snapshot Coral serves.
# Candidates:
#   deepseek-ai/DeepSeek-V4.1-Flash-Fast        (September release)
#   deepseek-ai/DeepSeek-V4.1-Flash-1017-Fast   (October 17 snapshot)
# If unknown, the harness defaults to the 1017 slug and logs an unresolved confound.
BASETEN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017-Fast

# Proxy bind (defaults shown)
PROXY_HOST=127.0.0.1
PROXY_PORT=8787
